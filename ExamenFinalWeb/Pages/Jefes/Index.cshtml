@page
@model ExamenFinalWeb.Pages.Jefes.IndexModel
@{
    ViewData["Title"] = "Jefes";
}

@section Styles {
    <!-- GLightbox: ver las fotos en grande -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/css/glightbox.min.css" />
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="titulo mb-0"><i class="bi bi-person-badge"></i> Jefes</h1>
        <p class="text-muted mb-0 small">Haz clic en una foto para verla en grande.</p>
    </div>
    @if (Model.EsAdmin)
    {
        <a asp-page="Create" class="btn btn-success"><i class="bi bi-plus-lg"></i> Nuevo jefe</a>
    }
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success alert-dismissible fade show">
        @mensaje
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (Model.MensajeError is not null)
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

<div class="card tarjeta">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span>Listado de jefes</span>
        <span class="badge bg-light text-success">
            @Model.Jefes.Count registrados · @Model.Jefes.Count(j => j.EstaLibre) libres
        </span>
    </div>
    <div class="card-body pb-0">
        <input id="buscar" class="form-control mb-3" placeholder="Buscar por nombre, cargo o correo..." />
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 80px;">Foto</th>
                    <th>Nombre</th>
                    <th>Cargo</th>
                    <th>Correo</th>
                    <th>Proyecto a cargo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in Model.Jefes)
                {
                    <tr class="fila">
                        <td>
                            @if (!string.IsNullOrEmpty(j.Foto))
                            {
                                var url = "/" + j.Foto;   // la foto está en wwwroot/imagenes de la Web
                                <a href="@url" class="glightbox" data-gallery="jefes" data-title="@j.Nombre" data-description="@j.Cargo">
                                    <img src="@url" class="miniatura" alt="@j.Nombre" />
                                </a>
                            }
                            else
                            {
                                <span class="avatar">@j.Nombre.Substring(0, 1).ToUpper()</span>
                            }
                        </td>
                        <td class="fw-semibold">@j.Nombre</td>
                        <td>@j.Cargo</td>
                        <td class="text-muted">@j.Correo</td>
                        <td>
                            @if (j.EstaLibre)
                            {
                                <span class="badge bg-secondary">Libre</span>
                            }
                            else
                            {
                                <span class="badge bg-success">@j.ProyectoNombre</span>
                            }
                        </td>
                    </tr>
                }
                <tr id="sinResultados" class="d-none">
                    <td colspan="5" class="text-center text-muted py-4">No se encontraron jefes.</td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/js/glightbox.min.js"></script>
    <script>
        GLightbox({ selector: '.glightbox' });

        // Buscador: filtra las filas mientras escribes
        document.getElementById('buscar').addEventListener('input', function () {
            const texto = this.value.toLowerCase().trim();
            let visibles = 0;
            document.querySelectorAll('.fila').forEach(fila => {
                const coincide = fila.innerText.toLowerCase().includes(texto);
                fila.classList.toggle('d-none', !coincide);
                if (coincide) visibles++;
            });
            document.getElementById('sinResultados').classList.toggle('d-none', visibles > 0);
        });
    </script>
}
