<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Examen Final · Proyectos</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var usuario = Context.Request.Cookies["usuario"];
        var rol = Context.Request.Cookies["rol"];
        var conSesion = Context.Request.Cookies["token"] != null;
    }

    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-verde shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Index"><i class="bi bi-kanban"></i> Examen Final · Proyectos</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="menu">
                    @if (conSesion)
                    {
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link" asp-page="/Index">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Jefes/Index">Jefes</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Proyectos/Index">Proyectos</a></li>
                            <li class="nav-item"><a class="nav-link" asp-page="/Proyectos/Buscar">Buscar por ID</a></li>
                        </ul>
                        <span class="text-white me-3 small">
                            <i class="bi bi-person-circle"></i> @usuario
                            <span class="badge @(rol == "Administrador" ? "bg-warning text-dark" : "bg-light text-success")">@rol</span>
                        </span>
                        <a class="btn btn-outline-light btn-sm" asp-page="/Login" asp-page-handler="Salir">Cerrar sesión</a>
                    }
                    else
                    {
                        <span class="me-auto"></span>
                        <a class="btn btn-light btn-sm" asp-page="/Login">Iniciar sesión</a>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top py-3 text-center text-muted small bg-white">
        &copy; 2026 · Examen Final · Proyectos · Programación Web II - UPDS
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
