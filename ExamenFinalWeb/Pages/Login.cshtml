@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="card tarjeta mx-auto mt-4" style="max-width: 420px;">
    <div class="card-header text-center py-3">
        <i class="bi bi-shield-lock fs-3 d-block"></i>
        Iniciar sesión
    </div>
    <div class="card-body p-4">
        @if (Model.MensajeError is not null)
        {
            <div class="alert alert-danger">@Model.MensajeError</div>
        }

        <form method="post">
            <div class="mb-3">
                <label asp-for="Datos.NombreUsuario" class="form-label">Usuario</label>
                <input asp-for="Datos.NombreUsuario" class="form-control" autofocus />
                <span asp-validation-for="Datos.NombreUsuario" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Datos.Password" class="form-label">Contraseña</label>
                <input asp-for="Datos.Password" type="password" class="form-control" />
                <span asp-validation-for="Datos.Password" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-success w-100">
                <i class="bi bi-box-arrow-in-right"></i> Entrar
            </button>
        </form>

        <p class="text-muted small text-center mt-3 mb-0">Usuario de prueba: <b>admin</b> / <b>123456</b></p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
