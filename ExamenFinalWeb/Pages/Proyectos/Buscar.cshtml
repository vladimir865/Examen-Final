@page
@model ExamenFinalWeb.Pages.Proyectos.BuscarModel
@{
    ViewData["Title"] = "Buscar proyecto";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/css/glightbox.min.css" />
}

<h1 class="titulo mb-4"><i class="bi bi-search"></i> Buscar proyecto por ID</h1>

<div class="card tarjeta mb-4">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <input asp-for="Id" class="form-control" placeholder="Pega aquí el ID del proyecto" />
            </div>
            <div class="col-md-3 d-grid">
                <button type="submit" class="btn btn-success"><i class="bi bi-search"></i> Buscar</button>
            </div>
        </form>
        <div class="form-text">
            Puedes copiar un ID desde la <a asp-page="Index">lista de proyectos</a> (botón <i class="bi bi-clipboard"></i>).
        </div>
    </div>
</div>

@if (Model.MensajeError is not null)
{
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i> @Model.MensajeError</div>
}

@if (Model.Proyecto is { } p)
{
    <div class="card tarjeta">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span><i class="bi bi-folder2-open"></i> @p.Nombre</span>
            <span class="badge @ExamenFinalWeb.Pages.Proyectos.IndexModel.ColorEstado(p.Estado)">@p.Estado</span>
        </div>
        <div class="card-body">
            <div class="row g-4 align-items-center">
                <div class="col-md-8">
                    <dl class="row mb-0">
                        <dt class="col-sm-4">ID</dt>
                        <dd class="col-sm-8 id-corto">@p.Id</dd>

                        <dt class="col-sm-4">Nombre</dt>
                        <dd class="col-sm-8">@p.Nombre</dd>

                        <dt class="col-sm-4">Descripción</dt>
                        <dd class="col-sm-8">@p.Descripcion</dd>

                        <dt class="col-sm-4">Estado</dt>
                        <dd class="col-sm-8">@p.Estado</dd>

                        <dt class="col-sm-4">Jefe a cargo</dt>
                        <dd class="col-sm-8">@p.NombreJefe <span class="text-muted">(@p.CargoJefe)</span></dd>
                    </dl>
                </div>
                <div class="col-md-4 text-center">
                    @if (!string.IsNullOrEmpty(p.FotoJefe))
                    {
                        var url = "/" + p.FotoJefe;
                        <a href="@url" class="glightbox" data-title="@p.NombreJefe" data-description="@p.CargoJefe">
                            <img src="@url" class="foto-grande" alt="@p.NombreJefe" />
                        </a>
                    }
                    else
                    {
                        <span class="avatar avatar-grande">@p.NombreJefe.Substring(0, 1).ToUpper()</span>
                    }
                    <div class="mt-2 fw-semibold">@p.NombreJefe</div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/glightbox@3.3.0/dist/js/glightbox.min.js"></script>
    <script>GLightbox({ selector: '.glightbox' });</script>
}
