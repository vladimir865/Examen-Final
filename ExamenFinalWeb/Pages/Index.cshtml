@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<div class="mb-4">
    <h1 class="titulo"><i class="bi bi-kanban"></i> Gestión de Proyectos</h1>
    <p class="text-muted mb-0">Registra jefes y proyectos. Cada jefe puede estar a cargo de un solo proyecto.</p>
</div>

@if (Model.MensajeError is not null)
{
    <div class="alert alert-danger">@Model.MensajeError</div>
}

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="stat p-3">
            <div class="text-muted small">Jefes</div>
            <div class="numero">@Model.TotalJefes</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat p-3">
            <div class="text-muted small">Jefes libres</div>
            <div class="numero">@Model.JefesLibres</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat p-3">
            <div class="text-muted small">Proyectos</div>
            <div class="numero">@Model.TotalProyectos</div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="stat p-3">
            <div class="text-muted small">En progreso</div>
            <div class="numero">@Model.ProyectosEnProgreso</div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card tarjeta h-100">
            <div class="card-body">
                <h5><i class="bi bi-person-badge text-success"></i> Jefes</h5>
                <p class="text-muted small">Lista de jefes con su foto y el proyecto que tienen a cargo.</p>
                <a asp-page="/Jefes/Index" class="btn btn-outline-success btn-sm">Ver jefes</a>
                @if (Model.EsAdmin)
                {
                    <a asp-page="/Jefes/Create" class="btn btn-success btn-sm">+ Nuevo jefe</a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card tarjeta h-100">
            <div class="card-body">
                <h5><i class="bi bi-folder2-open text-success"></i> Proyectos</h5>
                <p class="text-muted small">Proyectos con su estado y el jefe a cargo.</p>
                <a asp-page="/Proyectos/Index" class="btn btn-outline-success btn-sm">Ver proyectos</a>
                @if (Model.EsAdmin)
                {
                    <a asp-page="/Proyectos/Create" class="btn btn-success btn-sm">+ Nuevo proyecto</a>
                }
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card tarjeta h-100">
            <div class="card-body">
                <h5><i class="bi bi-search text-success"></i> Buscar por ID</h5>
                <p class="text-muted small">Encuentra un proyecto escribiendo su ID.</p>
                <a asp-page="/Proyectos/Buscar" class="btn btn-outline-success btn-sm">Buscar proyecto</a>
            </div>
        </div>
    </div>
</div>
